{
  "buildCommand": "bash build.sh",
  "outputDirectory": ".",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://eu.i.posthog.com https://eu-assets.i.posthog.com; connect-src 'self' https://eu.i.posthog.com https://eu.posthog.com https://www.structuro.ai; img-src 'self' data: https:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; object-src 'none'; base-uri 'self'; form-action 'self'"
        }
      ]
    },
    {
      "source": "/uploads/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/js/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "structuro.eu" }],
      "destination": "https://www.structuro.eu/:path*",
      "permanent": true
    },
    {
      "source": "/v2",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/v2/",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/gidsen",
      "destination": "/gidsen/",
      "permanent": true
    },
    {
      "source": "/waarom-gewoon-beginnen-niet-werkt",
      "destination": "/waarom-gewoon-beginnen-niet-werkt/",
      "permanent": true
    },
    {
      "source": "/een-stap-per-dag",
      "destination": "/een-stap-per-dag/",
      "permanent": true
    },
    {
      "source": "/waarom-planners-falen",
      "destination": "/waarom-planners-falen/",
      "permanent": true
    },
    {
      "source": "/mentale-belasting-dagstart",
      "destination": "/mentale-belasting-dagstart/",
      "permanent": true
    },
    {
      "source": "/energie-first",
      "destination": "/energie-first/",
      "permanent": true
    },
    {
      "source": "/cyclus",
      "destination": "/cyclus/",
      "permanent": true
    },
    {
      "source": "/waitlist",
      "destination": "https://www.structuro.ai/onboarding?utm_source=structuro_eu&utm_medium=organic&utm_campaign=eu_v2&utm_content=waitlist_legacy",
      "permanent": false
    },
    {
      "source": "/waitlist/",
      "destination": "https://www.structuro.ai/onboarding?utm_source=structuro_eu&utm_medium=organic&utm_campaign=eu_v2&utm_content=waitlist_legacy",
      "permanent": false
    },
    {
      "source": "/inschrijven",
      "destination": "https://www.structuro.ai/onboarding?utm_source=structuro_eu&utm_medium=organic&utm_campaign=eu_v2&utm_content=waitlist_legacy",
      "permanent": false
    },
    {
      "source": "/inschrijven/",
      "destination": "https://www.structuro.ai/onboarding?utm_source=structuro_eu&utm_medium=organic&utm_campaign=eu_v2&utm_content=waitlist_legacy",
      "permanent": false
    },
    {
      "source": "/wachtlijst",
      "destination": "https://www.structuro.ai/onboarding?utm_source=structuro_eu&utm_medium=organic&utm_campaign=eu_v2&utm_content=waitlist_legacy",
      "permanent": false
    },
    {
      "source": "/wachtlijst/",
      "destination": "https://www.structuro.ai/onboarding?utm_source=structuro_eu&utm_medium=organic&utm_campaign=eu_v2&utm_content=waitlist_legacy",
      "permanent": false
    },
    {
      "source": "/tiktok",
      "destination": "https://www.structuro.ai/social/tiktok",
      "permanent": false
    },
    {
      "source": "/tiktok/",
      "destination": "https://www.structuro.ai/social/tiktok",
      "permanent": false
    },
    {
      "source": "/instagram",
      "destination": "https://www.structuro.ai/social/instagram",
      "permanent": false
    },
    {
      "source": "/instagram/",
      "destination": "https://www.structuro.ai/social/instagram",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/gidsen/",
      "destination": "/gidsen/index.html"
    },
    {
      "source": "/cyclus/",
      "destination": "/cyclus/index.html"
    },
    {
      "source": "/waarom-gewoon-beginnen-niet-werkt/",
      "destination": "/waarom-gewoon-beginnen-niet-werkt/index.html"
    },
    {
      "source": "/een-stap-per-dag/",
      "destination": "/een-stap-per-dag/index.html"
    },
    {
      "source": "/waarom-planners-falen/",
      "destination": "/waarom-planners-falen/index.html"
    },
    {
      "source": "/mentale-belasting-dagstart/",
      "destination": "/mentale-belasting-dagstart/index.html"
    },
    {
      "source": "/energie-first/",
      "destination": "/energie-first/index.html"
    },
    {
      "source": "/ph/static/:path(.*)",
      "destination": "https://eu-assets.i.posthog.com/static/:path"
    },
    {
      "source": "/ph/array/:path(.*)",
      "destination": "https://eu-assets.i.posthog.com/array/:path"
    },
    {
      "source": "/ph/:path(.*)",
      "destination": "https://eu.i.posthog.com/:path"
    }
  ]
}
